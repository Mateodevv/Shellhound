# Copy to .env and choose a long random token (for example from a password manager).
# This is the local Shellhound access token, not an OpenCTI/provider API key.
SHELLHOUND_TOKEN=
# Existing host directory; use forward slashes on Windows, e.g. D:/Evidence.
# Register its contents inside Shellhound using /evidence/... paths.
SHELLHOUND_EVIDENCE_DIR=
SHELLHOUND_PUBLISHED_PORT=8710
